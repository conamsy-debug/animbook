# AnimBook Web — production env (DO NOT COMMIT actual keys).
# Copy this file to .env.production (Next.js auto-loads it during `next build`).

NEXT_PUBLIC_API_URL=https://api.animbook.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1
NEXT_PUBLIC_RELEASE=animbook-web@0.11.0

# Optional — the public URL of the mobile + tv shells if you host them
# on a different origin. Default is /mobile and /tv on the same domain.
NEXT_PUBLIC_MOBILE_URL=
NEXT_PUBLIC_TV_URL=
