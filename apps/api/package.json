{
  "name": "@animbook/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "prisma generate && tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "prisma generate && tsc -p tsconfig.json --noEmit",
    "test": "node --test dist",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "prisma migrate reset --force",
    "clips:seed": "tsx scripts/generate-seed-clips.ts",
    "clips:probe": "tsx scripts/probe-runway-refs.ts",
    "books:subcategories": "tsx scripts/assign-subcategories.ts",
    "books:archive-tests": "tsx scripts/archive-test-books.ts"
  },
  "dependencies": {
    "@apollo/server": "^4.12.2",
    "@clerk/backend": "^3.13.1",
    "@prisma/client": "^6.19.0",
    "aws4fetch": "1.0.20",
    "bullmq": "^5.34.10",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "graphql": "^16.10.0",
    "helmet": "^8.0.0",
    "ioredis": "^5.4.2",
    "jose": "^5.10.0",
    "mammoth": "1.12.3",
    "unpdf": "1.8.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/ioredis": "^5.0.0",
    "@types/node": "^22.10.7",
    "prisma": "^6.19.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
