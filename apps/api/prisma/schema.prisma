generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserTier {
  BASIC
  PREMIUM
  ENTERPRISE
}

enum SubscriptionStatus {
  INCOMPLETE
  ACTIVE
  PAST_DUE
  CANCELED
  EXPIRED
}

enum BookVertical {
  CONSUMER
  KIDS
  EDU
  FAITH
  DOCS
  VERSE
  COMICS
  BUSINESS
  WELLNESS
  LAW
  TRAVEL
  ORIGINALS
}

enum BookStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ExpertReviewStatus {
  NOT_REQUIRED
  PENDING
  IN_REVIEW
  APPROVED
  CHANGES_REQUESTED
}

enum PageStatus {
  PENDING
  APPROVED
  FLAGGED
  REGENERATING
}

/// Split-pipeline: lifecycle of a page's still image (poster frame).
/// NONE      = no still requested yet
/// GENERATING = a worker is calling Runway gen4_image for this page
/// READY     = still uploaded to R2, awaiting author approval
/// APPROVED  = author approved the still; ANIMATE_PAGE may run
/// FAILED    = last attempt failed; page is blocked until regenerated
enum StillStatus {
  NONE
  GENERATING
  READY
  APPROVED
  FAILED
}

/// Split-pipeline: lifecycle of a page's animated clip.
/// NONE      = no clip requested yet (still not approved, or this is a non-moving page)
/// QUEUED    = ANIMATE_PAGE job is queued
/// GENERATING = Runway is animating the approved still
/// READY     = clip uploaded to R2, awaiting author approval
/// APPROVED  = author approved the clip
/// FLAGGED   = author flagged the clip (e.g. quality triage)
/// FAILED    = last animation attempt failed
/// STALE     = the still was regenerated or invalidated after this clip was
///             generated; do NOT animate, the still→clip pairing is gone
enum ClipStatus {
  NONE
  QUEUED
  GENERATING
  READY
  APPROVED
  FLAGGED
  FAILED
  STALE
}

/// Split-pipeline: lifecycle of a page's narration track.
/// NONE      = not generated
/// GENERATING = ElevenLabs is synthesising
/// READY     = audio uploaded to R2
/// FAILED    = last attempt failed
enum AudioStatus {
  NONE
  GENERATING
  READY
  FAILED
}

/// Split-pipeline: how long the clip should be. HERO is real action or a
/// key story moment; STANDARD is the default. Part A pins both at 10s;
/// Part B will move STANDARD to 5s and let the Brain / author override.
enum MotionTier {
  HERO
  STANDARD
}

/// Lifecycle of an author's cloned narrator voice.
enum VoiceStatus {
  NONE
  UPLOADING
  CLONED
  FAILED
  REMOVED
}

/// How a book reaches its readers. IMMEDIATE publishes every page at once
/// (legacy behaviour). TIME drips on a calendar cadence the author picks.
/// TASK drips one chunk each time a reader submits the daily task.
enum ReleaseMode {
  IMMEDIATE
  TIME
  TASK
}

/// Calendar cadence used by ReleaseMode.TIME.
enum ReleaseCadence {
  DAILY
  WEEKLY
  MONTHLY
}

enum ReadingMode {
  WATCH
  BOTH
  READ
}

/// Trailer + marketing share link lifecycle.
enum ShareStatus {
  PENDING
  GENERATING
  READY
  FAILED
  REVOKED
}

enum InstitutionType {
  SCHOOL
  UNIVERSITY
  CORPORATE
}

enum StudioProjectStatus {
  SETUP
  ANALYZING
  BRAIN_REVIEW
  STYLE_SELECTION
  STYLE_TRAINING
  GENERATING
  REVIEW
  AUDIO
  READY_TO_PUBLISH
  PUBLISHED
  FAILED
}

enum PipelineStage {
  MANUSCRIPT_INGESTION
  BOOK_BRAIN_ANALYSIS
  VISUAL_STYLE
  PROMPT_GENERATION
  VIDEO_GENERATION
  QUALITY_TRIAGE
  AUDIO_PRODUCTION
  ASSEMBLY
  METADATA_UPLOAD
  PUBLISH
  TRAILER_GENERATION
}

enum JobStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  RETRYING
}

model User {
  id                       String                @id @default(cuid())
  clerkId                  String                @unique @map("clerk_id")
  email                    String                @unique
  name                     String
  tier                     UserTier              @default(BASIC)
  /// Public @handle, set by the reader; also the URL of their author page.
  handle                   String?               @unique
  bio                      String?
  /// Profile photo copied from the sign-in provider.
  avatarUrl                String?               @map("avatar_url")
  /// Community writing (notes, circles, messages) off — school and child accounts.
  communityDisabled        Boolean               @default(false) @map("community_disabled")
  /// ADULT, SCHOOL (in a classroom) or MINOR (declared under-18). Anything
  /// other than ADULT is a protected account: no private messaging at all,
  /// in either direction. Set by the server, never by the account holder.
  accountKind              String                @default("ADULT") @map("account_kind")
  /// Readers may message this author about their books.
  messagesOpen             Boolean               @default(true) @map("messages_open")
  /// ElevenLabs voice_id cloned from author-uploaded samples. Authors who
  /// have this set become narrators of their own books automatically.
  narratorVoiceId          String?               @map("narrator_voice_id")
  voiceStatus              VoiceStatus           @default(NONE) @map("voice_status")
  /// R2 URL of the audio samples uploaded. Stored so authors can replace
  /// without losing the consent trail, and ops can audit or re-train.
  /// For single-file uploads (legacy) this is the only URL. For multi-file
  /// uploads it's the first sample; the full list lives in voiceSampleUrls.
  voiceSampleUrl           String?               @map("voice_sample_url")
  /// Array of R2 URLs for every individual sample uploaded during the most
  /// recent clone. Null for users who only ever uploaded a single file
  /// before this column existed; legacy rows stay readable via the
  /// single voiceSampleUrl field.
  voiceSampleUrls          Json?                 @map("voice_sample_urls")
  /// Heuristic quality score 0-100 for the latest clone. Weighted sum of
  /// sample count, total duration, audio format / bitrate. Higher = better
  /// trained clone. Null until computed by services/voiceQuality.
  voiceQualityScore        Int?                  @map("voice_quality_score")
  /// Per-component breakdown so the UI can show "samples: 4/5 · duration:
  /// 2:13 · format: mp3 192kbps" alongside the headline score.
  voiceQualityDetails      Json?                 @map("voice_quality_details")
  /// When voiceQualityScore was last computed. The score is stale once the
  /// underlying samples change (next clone / delete), so the UI can show a
  /// "recompute" hint if this is older than the latest sample upload.
  voiceQualityComputedAt   DateTime?             @map("voice_quality_computed_at")
  /// When the author confirmed they own the rights to the audio samples.
  /// Audited by IP and timestamp per voice-clone legal practice.
  voiceConsentAt           DateTime?             @map("voice_consent_at")
  voiceConsentIp           String?               @map("voice_consent_ip")
  /// Last upload error from ElevenLabs (rate limit, safety, format).
  voiceFailureReason       String?               @map("voice_failure_reason")
  roles                    String[]              @default([])
  subscriptionStatus       SubscriptionStatus?   @map("subscription_status")
  stripeCustomerId         String?               @unique @map("stripe_customer_id")
  createdAt                DateTime              @default(now()) @map("created_at")
  updatedAt                DateTime              @updatedAt @map("updated_at")
  libraryEntries           LibraryEntry[]
  subscriptions            Subscription[]
  checkpointResponses      CheckpointResponse[]
  administeredInstitutions Institution[]         @relation("InstitutionAdmin")
  studioProjects           StudioProject[]
  stageRoundsAuthored      StageRound[]          @relation("StageRoundLead")
  achievements             Achievement[]
  reviewsAuthored          ReviewDecision[]      @relation("ReviewAuthor")
  creatorRoyalties         RoyaltyEntry[]        @relation("CreatorPayee")
  memoryProfile            MemoryProfile?
  booksCreated             Book[]                @relation("BookCreator")
  following                Follow[]              @relation("Follower")
  followers                Follow[]              @relation("Followed")
  reportsMade              Report[]              @relation("Reporter")
  blocksMade               Block[]               @relation("Blocker")
  blocksReceived           Block[]               @relation("Blocked")
  pageNotes                PageNote[]
  circlesOwned             Circle[]              @relation("CircleOwner")
  circleMemberships        CircleMember[]
  circlePosts              CirclePost[]
  threadsAsReader          MessageThread[]       @relation("ThreadReader")
  threadsAsAuthor          MessageThread[]       @relation("ThreadAuthor")
  messagesSent             Message[]             @relation("MessageSender")
  apiKeys                  ApiKey[]
  pageSignalEvents         PageSignalEvent[]
  classroomsTeaching       Classroom[]           @relation("ClassroomTeacher")
  classroomMemberships     ClassroomMembership[] @relation("ClassroomStudent")
  taskSubmissions          BookTaskSubmission[]
  usageEvents              UsageEvent[]
  liveSessions             LiveSession[]        @relation("LiveHost")

  // AnimBook Languages (Phase 1) — Patch 02.
  langEnrollments          Enrollment[]
  langStoryProgress        StoryProgress[]
  langExerciseAttempts     ExerciseAttempt[]
  langPronunciationAttempts PronunciationAttempt[]
  langUserVocab            UserVocab[]
  langReviewLogs           ReviewLog[]
  learnerStats             LearnerStats?

  @@map("users")
}

/// One reader following an author.
model Follow {
  id         String   @id @default(cuid())
  followerId String   @map("follower_id")
  authorId   String   @map("author_id")
  createdAt  DateTime @default(now()) @map("created_at")
  follower   User     @relation("Follower", fields: [followerId], references: [id], onDelete: Cascade)
  author     User     @relation("Followed", fields: [authorId], references: [id], onDelete: Cascade)

  @@unique([followerId, authorId])
  @@index([authorId])
  @@map("follows")
}

/// Anything a reader reports: a note, a circle post, a message or an account.
model Report {
  id         String   @id @default(cuid())
  targetType String   @map("target_type")
  targetId   String   @map("target_id")
  reporterId String   @map("reporter_id")
  reason     String
  detail     String?
  status     String   @default("OPEN")
  createdAt  DateTime @default(now()) @map("created_at")
  reporter   User     @relation("Reporter", fields: [reporterId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([targetType, targetId])
  @@map("reports")
}

/// One reader blocking another: hides their writing and stops messages.
model Block {
  id        String   @id @default(cuid())
  blockerId String   @map("blocker_id")
  blockedId String   @map("blocked_id")
  createdAt DateTime @default(now()) @map("created_at")
  blocker   User     @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked   User     @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@map("blocks")
}

/// A short note a reader leaves in the margin of one page.
model PageNote {
  id        String   @id @default(cuid())
  pageId    String   @map("page_id")
  bookId    String   @map("book_id")
  userId    String   @map("user_id")
  text      String
  /// VISIBLE (published), HELD (screening wants a look), REMOVED (taken down).
  status    String   @default("VISIBLE")
  createdAt DateTime @default(now()) @map("created_at")
  page      Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)
  book      Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([pageId, status, createdAt])
  @@index([bookId, status])
  @@index([userId])
  @@map("page_notes")
}

/// A small private group reading a book together.
model Circle {
  id         String         @id @default(cuid())
  name       String
  bookId     String?        @map("book_id")
  ownerId    String         @map("owner_id")
  /// Secret code in the invite link.
  inviteCode String         @unique @map("invite_code")
  createdAt  DateTime       @default(now()) @map("created_at")
  owner      User           @relation("CircleOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  book       Book?          @relation(fields: [bookId], references: [id], onDelete: SetNull)
  members    CircleMember[]
  posts      CirclePost[]

  @@index([ownerId])
  @@map("circles")
}

model CircleMember {
  id       String   @id @default(cuid())
  circleId String   @map("circle_id")
  userId   String   @map("user_id")
  role     String   @default("MEMBER")
  joinedAt DateTime @default(now()) @map("joined_at")
  circle   Circle   @relation(fields: [circleId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([circleId, userId])
  @@index([userId])
  @@map("circle_members")
}

model CirclePost {
  id        String   @id @default(cuid())
  circleId  String   @map("circle_id")
  userId    String   @map("user_id")
  text      String
  /// Optional page this post is about.
  pageNum   Int?     @map("page_num")
  status    String   @default("VISIBLE")
  createdAt DateTime @default(now()) @map("created_at")
  circle    Circle   @relation(fields: [circleId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([circleId, createdAt])
  @@map("circle_posts")
}

/// One private conversation between a reader and an author.
///
/// Only a reader can open a thread, and only with an author who has books and
/// has left messagesOpen on. There is no reader-to-reader thread: the pair is
/// always (reader, author). Neither side may be a protected account — see
/// services/accountStanding.ts, which is checked on every send and every read.
model MessageThread {
  id            String    @id @default(cuid())
  readerId      String    @map("reader_id")
  authorId      String    @map("author_id")
  /// The book the reader was reading when they wrote, if any.
  bookId        String?   @map("book_id")
  /// OPEN, or CLOSED once the author ends it.
  status        String    @default("OPEN")
  createdAt     DateTime  @default(now()) @map("created_at")
  lastMessageAt DateTime  @default(now()) @map("last_message_at")
  readerReadAt  DateTime? @map("reader_read_at")
  authorReadAt  DateTime? @map("author_read_at")
  reader        User      @relation("ThreadReader", fields: [readerId], references: [id], onDelete: Cascade)
  author        User      @relation("ThreadAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  book          Book?     @relation(fields: [bookId], references: [id], onDelete: SetNull)
  messages      Message[]

  @@unique([readerId, authorId])
  @@index([authorId, lastMessageAt])
  @@index([readerId, lastMessageAt])
  @@map("message_threads")
}

model Message {
  id        String        @id @default(cuid())
  threadId  String        @map("thread_id")
  senderId  String        @map("sender_id")
  text      String
  /// VISIBLE (delivered), HELD (screening wants a look), REMOVED (taken down).
  status    String        @default("VISIBLE")
  createdAt DateTime      @default(now()) @map("created_at")
  thread    MessageThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  sender    User          @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([threadId, createdAt])
  @@index([senderId])
  @@map("messages")
}

model Publisher {
  id                  String   @id @default(cuid())
  name                String
  contactEmail        String   @map("contact_email")
  licenseAgreementUrl String?  @map("license_agreement_url")
  revenueSharePct     Float    @default(0) @map("revenue_share_pct")
  createdAt           DateTime @default(now()) @map("created_at")
  books               Book[]

  @@map("publishers")
}

model Book {
  id                      String               @id @default(cuid())
  slug                    String               @unique
  title                   String
  subtitle                String?
  subcategory             String?
  author                  String
  synopsis                String               @db.Text
  isbn                    String?              @unique
  publisherId             String?              @map("publisher_id")
  /// The AnimBook account that made this book (Studio); null for originals.
  creatorId               String?              @map("creator_id")
  vertical                BookVertical
  status                  BookStatus           @default(DRAFT)
  styleId                 String?              @map("style_id")
  totalPages              Int                  @default(0) @map("total_pages")
  genreTags               String[]             @default([]) @map("genre_tags")
  moodTags                String[]             @default([]) @map("mood_tags")
  ageRating               String?              @map("age_rating")
  language                String               @default("en")
  narrationLanguages      String[]             @default([]) @map("narration_languages")
  coverUrl                String?              @map("cover_url")
  /// When true, this book runs through STILL_PAGE → (author approval) →
  /// ANIMATE_PAGE instead of the legacy single-stage VIDEO_GENERATION
  /// pipeline. Authors opt in per book by flipping this in the DB.
  splitPipeline           Boolean              @default(false) @map("split_pipeline")
  requiresExpertReview    Boolean              @default(false) @map("requires_expert_review")
  expertReviewStatus      ExpertReviewStatus   @default(NOT_REQUIRED) @map("expert_review_status")
  iconographicNotes       String?              @map("iconographic_notes") @db.Text
  /// Release schedule. IMMEDIATE = all pages live at PUBLISHED. TIME = a
  /// calendar drip on cadence + chunk%. TASK = one chunk unlocks per reader
  /// submission of the daily task. Null = legacy rows, treated as IMMEDIATE.
  releaseMode             ReleaseMode?         @map("release_mode")
  releaseCadence          ReleaseCadence?      @map("release_cadence")
  /// Whole-book percentage per chunk (10 or 25). Rounded up so the last chunk
  /// can be a bit larger; never below 1 page.
  releaseChunkPercent     Int?                 @map("release_chunk_percent")
  /// When the first chunk goes live. Null means "right now".
  releaseStartAt          DateTime?            @map("release_start_at")
  /// When the schedule was locked by the author. After this, schedule fields
  /// are immutable until the book is archived + republished.
  releaseScheduleLockedAt DateTime?            @map("release_schedule_locked_at")
  chunks                  BookChunk[]
  dailyTasks              BookDailyTask[]
  taskSubmissions         BookTaskSubmission[]
  createdAt               DateTime             @default(now()) @map("created_at")
  updatedAt               DateTime             @updatedAt @map("updated_at")
  publisher               Publisher?           @relation(fields: [publisherId], references: [id], onDelete: SetNull)
  creator                 User?                @relation("BookCreator", fields: [creatorId], references: [id], onDelete: SetNull)
  pageNotes               PageNote[]
  circles                 Circle[]
  messageThreads          MessageThread[]
  pages                   Page[]
  libraryEntries          LibraryEntry[]
  brain                   BookBrain?
  studioProject           StudioProject?
  reviewDecisions         ReviewDecision[]
  royaltyEntries          RoyaltyEntry[]
  oracleTrees             OracleTree[]
  liveSessions            LiveSession[]
  worldMembership         WorldMember?
  archiveProject          ArchiveProject?
  shares                  BookShare[]
  usageEvents             UsageEvent[]

  @@index([vertical, subcategory, status])
  @@index([vertical, status])
  @@index([title])
  @@index([status, language])
  @@index([status, vertical, updatedAt])
  @@map("books")
}

/// One dripped chunk of a book. Materialised at publish time so the read
/// path is a cheap range scan. For TIME books `releasedAt` is set the moment
/// `scheduledFor` passes (lazy on first read, no cron needed). For TASK
/// books `releasedAt` is set per-reader via `BookTaskSubmission`.
model BookChunk {
  id           String    @id @default(cuid())
  bookId       String    @map("book_id")
  /// Zero-based chunk index in author-publish order.
  chunkIndex   Int       @map("chunk_index")
  pageStart    Int       @map("page_start")
  pageEnd      Int       @map("page_end")
  /// When this chunk is supposed to go live (TIME mode).
  scheduledFor DateTime  @map("scheduled_for")
  /// When the system actually released it. Null = still waiting (TIME) or
  /// per-reader gated (TASK). For TASK books this stays null globally — the
  /// gate is in BookTaskSubmission.
  releasedAt   DateTime? @map("released_at")
  book         Book      @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@unique([bookId, chunkIndex])
  @@index([bookId, scheduledFor])
  @@map("book_chunks")
}

/// The one-line daily task the author writes per chunk in task-dripped mode.
/// Empty in IMMEDIATE / TIME mode.
model BookDailyTask {
  id         String   @id @default(cuid())
  bookId     String   @map("book_id")
  chunkIndex Int      @map("chunk_index")
  prompt     String   @db.Text
  createdAt  DateTime @default(now()) @map("created_at")
  book       Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@unique([bookId, chunkIndex])
  @@map("book_daily_tasks")
}

/// A reader's submission of the daily task. Recording one unlocks that
/// chunk for the reader; in TIME books this table is unused.
model BookTaskSubmission {
  id          String   @id @default(cuid())
  bookId      String   @map("book_id")
  chunkIndex  Int      @map("chunk_index")
  userId      String   @map("user_id")
  text        String   @db.Text
  submittedAt DateTime @default(now()) @map("submitted_at")
  book        Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// One submission per reader per chunk is enough — we don't enforce
  /// uniqueness because a reader can resubmit if they want to update their
  /// reflection. The newest submission wins for the unlock check.
  @@index([userId, bookId])
  @@index([bookId, chunkIndex])
  @@map("book_task_submissions")
}

model Page {
  id                String       @id @default(cuid())
  bookId            String       @map("book_id")
  pageNum           Int          @map("page_num")
  chapter           String?
  textExcerpt       String       @map("text_excerpt") @db.Text
  sourceTextSha256  String       @map("source_text_sha256")
  animationPrompt   String?      @map("animation_prompt") @db.Text
  negativePrompt    String?      @map("negative_prompt") @db.Text
  videoUrl          String?      @map("video_url")
  posterUrl         String?      @map("poster_url")
  audioUrl          String?      @map("audio_url")
  vttUrl            String?      @map("vtt_url")
  qualityScore      Float?       @map("quality_score")
  status            PageStatus   @default(PENDING)
  directionNote     String?      @map("direction_note") @db.Text
  regenerationCount Int          @default(0) @map("regeneration_count")
  sceneType         String?      @map("scene_type")
  emotionalRegister String?      @map("emotional_register")
  cameraAngle       String?      @map("camera_angle")
  speakerName       String?      @map("speaker_name")
  /// Split-pipeline: still lifecycle. NONE for legacy books; APPROVED
  /// for any page that already had a poster uploaded at migration time.
  stillStatus       StillStatus  @default(NONE) @map("still_status")
  /// Split-pipeline: clip lifecycle. Backfilled from `status` so existing
  /// APPROVED/FLAGGED/PENDING/REGENERATING pages keep working as before.
  clipStatus        ClipStatus   @default(NONE) @map("clip_status")
  /// Split-pipeline: audio lifecycle. Set to READY for any page that
  /// already has an audioUrl at migration time.
  audioStatus       AudioStatus  @default(NONE) @map("audio_status")
  /// Split-pipeline: prompt the author overrode for the still. Falls back
  /// to the Brain's animation_prompt_draft for pages that haven't been
  /// edited. Nullable so legacy rows stay clean.
  stillPrompt       String?      @map("still_prompt") @db.Text
  /// Split-pipeline: bump on every still regeneration so two ANIMATE_PAGE
  /// jobs for the same page never collide (Bull jobId includes the
  /// version). Backfilled to 0 for legacy rows.
  stillVersion      Int          @default(0) @map("still_version")
  /// Split-pipeline: HERO pages keep 10s clips; STANDARD is the default.
  /// Part A leaves both at 10s and lets Part B wire the override.
  motionTier        MotionTier   @default(STANDARD) @map("motion_tier")
  /// True when the author has manually overridden motionTier via
  /// PUT /api/pages/:pageId/motion-tier. Book Brain re-analysis
  /// (buildPrompts in pipeline.ts) skips writing motionTier on rows
  /// where this is true, so manual overrides survive a re-run.
  /// Default false so legacy rows behave exactly as before.
  motionTierOverridden Boolean   @default(false) @map("motion_tier_overridden")
  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime     @updatedAt @map("updated_at")
  book              Book         @relation(fields: [bookId], references: [id], onDelete: Cascade)
  checkpoints       Checkpoint[]
  notes             PageNote[]

  @@unique([bookId, pageNum])
  @@index([bookId, status])
  @@map("pages")
}

/// One row per external-cost event: a Runway image/video call, an
/// ElevenLabs TTS call, a per-page narration regenerate, etc. Used by
/// the /api/usage/summary endpoint and the Profile "Spending" section.
///
/// `kind` is the event family (ANIMATE_KICK | STILL_KICK |
/// NARRATION_KICK | AUDIO_REGEN | TRAILER). `provider` is the vendor
/// (RUNWAY | ELEVENLABS). `units` is whatever the provider bills on:
/// pages for Runway kicks, characters for ElevenLabs TTS, seconds for
/// trailers. `unitCostUsd` × `units` = `totalUsd` (computed at write
/// time so historical reports don't drift if pricing changes).
model UsageEvent {
  id            String   @id @default(cuid())
  userId        String   @map("user_id")
  bookId        String   @map("book_id")
  pageId        String?  @map("page_id")
  kind          String
  provider      String
  units         Int
  unitCostUsd   Float    @map("unit_cost_usd")
