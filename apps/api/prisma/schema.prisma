/// AnimBook DREAM — runtime sleep-mode sessions.
/// One row per WELLNESS-vertical read where the reader stayed in DREAM for
/// at least one page. Captures dwell time, the ambient track, and whether
/// the reader fell asleep (no progress events for > 20 minutes).
model DreamSession {
  id           String    @id @default(cuid())
  userId       String    @map("user_id")
  bookId       String    @map("book_id")
  ambientTrack String    @default("ocean_waves") @map("ambient_track")
  pagesRead    Int       @default(0) @map("pages_read")
  startedAt    DateTime  @default(now()) @map("started_at")
  endedAt      DateTime? @map("ended_at")
  fellAsleepAt DateTime? @map("fell_asleep_at")
  exitReason   String?   @map("exit_reason") @db.Text

  @@index([userId, startedAt])
  @@index([bookId, startedAt])
  @@index([endedAt])
  @@map("dream_sessions")
}

/// AnimBook STUDIO PRO — AR/NFC companion for every published AnimBook.
/// A CompanionLink mints a marker (QR-scannable) and an NFC tag id; the
/// web companion reads them to launch the book in AR overlay or pin
/// directly to a specific page.
model CompanionLink {
  id             String             @id @default(cuid())
  bookId         String             @map("book_id")
  markerHash     String             @unique @map("marker_hash")
  nfcTagId       String             @unique @map("nfc_tag_id")
  experienceMode String             @default("AR_OVERLAY") @map("experience_mode")
  anchorPage     Int                @default(1) @map("anchor_page")
  title          String?
  companionLabel String?            @map("companion_label")
  createdAt      DateTime           @default(now()) @map("created_at")
  updatedAt      DateTime           @updatedAt @map("updated_at")
  sessions       CompanionSession[]

  @@index([bookId])
  @@map("companion_links")
}

/// AnimBook STUDIO PRO — every time a reader opens the book via AR marker
/// or NFC tag, we log a session so the creator can see lifecycle reach.
model CompanionSession {
  id          String        @id @default(cuid())
  linkId      String        @map("link_id")
  userId      String        @map("user_id")
  triggerMode String        @map("trigger_mode")
  pageReached Int           @default(1) @map("page_reached")
  startedAt   DateTime      @default(now()) @map("started_at")
  endedAt     DateTime?     @map("ended_at")
  link        CompanionLink @relation(fields: [linkId], references: [id], onDelete: Cascade)

  @@index([linkId, startedAt])
  @@index([userId, startedAt])
  @@map("companion_sessions")
}

/// Marketing share link for a book. The token resolves at /share/<token>
/// to a public trailer-and-CTA landing page; authors drop the URL in
/// social bios and posts. Each share carries its own click counter so
/// authors can rotate tokens for re-launches without losing history.
model BookShare {
  id            String       @id @default(cuid())
  bookId        String       @map("book_id")
  /// Short opaque token (8 lowercase alphanumerics). Unique across the app.
  token         String       @unique
  /// Author's own ≤600-char hook used as the trailer's text + title-card copy
  /// + og:description for /book/<slug> + /share/<token> previews.
  hook          String       @db.Text
  /// Stitched MP4 trailer (3 × 10s clips). Set when status flips to READY.
  trailerUrl    String?      @map("trailer_url")
  /// Cover-with-title overlay. Used as og:image and the share landing poster.
  thumbnailUrl  String?      @map("thumbnail_url")
  status        ShareStatus  @default(PENDING)
  /// Last failure message from Runway/ffpmeg so authors can self-diagnose.
  failureReason String?      @map("failure_reason") @db.Text
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")
  book          Book         @relation(fields: [bookId], references: [id], onDelete: Cascade)
  clicks        ShareClick[]

  @@index([bookId])
  @@index([status])
  @@map("book_shares")
}

/// Every GET /share/<token> hits the row once. Keeps a row-level history
/// so an author can see traffic spikes per token per day.
model ShareClick {
  id      String    @id @default(cuid())
  shareId String    @map("share_id")
  referer String?   @db.Text
  at      DateTime  @default(now()) @map("at")
  share   BookShare @relation(fields: [shareId], references: [id], onDelete: Cascade)

  @@index([shareId, at])
  @@map("share_clicks")
}


