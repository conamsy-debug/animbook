# AnimBook API — production env (DO NOT COMMIT actual keys).
# Copy this file to .env (or paste the values into your host's secret
# manager) and fill in the placeholders.

NODE_ENV=production
PORT=4000

# Public origins that may call this API. Comma-separated for prod.
WEB_ORIGIN=https://animbook.com,https://www.animbook.com

# Postgres + Redis — use the host's connection strings.
# Railway / Render / Fly expose these as DATABASE_URL + REDIS_URL env vars
# automatically when you provision a Postgres + Redis add-on.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/animbook?schema=public
REDIS_URL=rediss://default:PASSWORD@HOST:6379

# Auth — Clerk live keys.
# Get them at https://dashboard.clerk.com → API Keys.
CLERK_SECRET_KEY=replace-with-your-clerk-secret-key
CLERK_PUBLISHABLE_KEY=replace-with-your-clerk-publishable-key
# Set to "false" in production. Demo tokens are for local dev only.
ALLOW_DEMO_AUTH=false

# Book Brain — Anthropic Claude.
# Get an API key at https://console.anthropic.com → Settings → API Keys.
ANTHROPIC_API_KEY=replace-with-your-anthropic-key
ANTHROPIC_BOOK_BRAIN_MODEL=claude-sonnet-4-5

# Video generation — Runway Gen-3 Alpha.
# Apply at https://runwayml.com/developers — production keys start at $$.
RUNWAY_API_KEY=

# Narration — ElevenLabs v2.
# Available at https://elevenlabs.io → Profile → API Key.
ELEVENLABS_API_KEY=

# Translation glosses — OpenAI is the lightest path for high-quality
# multilingual phrase generation when the live path is wired in.
OPENAI_API_KEY=

# Stripe — production keys.
# Get them at https://dashboard.stripe.com → Developers → API keys.
# The webhook secret is created when you add an endpoint
# (https://dashboard.stripe.com → Webhooks → Add endpoint → "checkout.session.completed").
STRIPE_SECRET_KEY=replace-with-your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=replace-with-your-stripe-webhook-signing-secret
# Price ids — created in the Stripe dashboard (Products → AnimBook Premium Monthly, etc.).
# The /api/legal/pricing route surfaces these live when set; otherwise the
# canonical placeholder strings ship.
STRIPE_PRICE_PREMIUM_MONTHLY=
STRIPE_PRICE_PREMIUM_YEARLY=
STRIPE_PRICE_STUDIO_MONTHLY=
STRIPE_PRICE_STUDIO_YEARLY=

# Cloudflare R2 — for storing generated video / poster assets.
# Get these at https://dash.cloudflare.com → R2 → Manage R2 API Tokens.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET=animbook-media
# Public CDN base — the host that fronts the R2 bucket.
# Set this to your Cloudflare Workers / R2 public dev domain or custom CDN.
CLOUDFLARE_CDN_BASE=https://media.animbook.com

# Observability — Sentry (optional but recommended).
# Create a project at https://sentry.io → New Project → Node / Express.
SENTRY_DSN=
# Sampling — 0.1 = 10% of traces. Drop to 0.01 (1%) when traffic is high.
SENTRY_TRACES_SAMPLE_RATE=0.1
# Optional — set when shipping a CI build (e.g. animbook-api@0.11.0-abc123).
RELEASE=animbook-api@0.11.0
