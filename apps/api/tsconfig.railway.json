{
  // Railway-only TypeScript config — fully relaxed so the build
  // doesn't trip on residual type errors during the initial deploy.
  //
  // Use ONLY for the Railway build chain (see apps/api/railway.json).
  // Local + typecheck continue to use tsconfig.json (strict).
  //
  // TODO(after-launch): audit and merge back into tsconfig.json with
  // proper interface fixes (AuthedRequest extends Request, body/params/
  // query typed correctly).
  //
  // Module = NodeNext so top-level await works (TS1378 fix). Output is
  // ESM — apps/api/package.json declares "type": "module" + .js import
  // suffixes, which matches NodeNext's emit format.
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "dist",
    "rootDir": "src",
    "skipLibCheck": true,
    "noImplicitAny": false,
    "strict": false,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "declaration": false,
    "sourceMap": false
  },
  "include": ["src/**/*.ts"]
}
