# AnimBook Web — production image (Next.js standalone, monorepo root context).
#
# Build:    docker build -f Dockerfile.web -t animbook-web:latest .
# Run:      docker run --rm -p 3000:3000 \
#             -e NEXT_PUBLIC_API_URL=https://api.animbook.com \
#             -e NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=... \
#             animbook-web:latest
#
# Multi-stage:
#   1. deps    — `npm ci` for just the web + domain workspaces (skip api/mobile/tv)
#   2. build   — `next build` with `output: "standalone"` → .next/standalone
#   3. runtime — minimal node:20-alpine + the standalone bundle

# ---- 1. deps ---------------------------------------------------------------
FROM node:20-alpine AS deps
WORKDIR /app

COPY package.json package-lock.json .npmrc ./

# Root tsconfig.base.json — packages/domain/tsconfig.json extends it.
COPY tsconfig.base.json ./

# Only the workspaces the Web needs. Skipping apps/api, apps/mobile,
# apps/tv entirely — they have heavy install steps that conflict with
# multi-workspace installs (EBUSY on .vite or node_modules).
COPY packages/domain/package.json ./packages/domain/
COPY apps/web/package.json ./apps/web/

RUN npm ci --legacy-peer-deps --ignore-scripts --no-audit --no-fund \
      --include-workspace-root \
      --workspace=apps/web \
      --workspace=packages/domain

# ---- 2. build --------------------------------------------------------------
FROM deps AS build
WORKDIR /app
ENV NODE_ENV=production

# Build-time public env vars baked into the JS bundle.
ARG NEXT_PUBLIC_API_URL
ARG NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY
ARG NEXT_PUBLIC_SENTRY_DSN
ARG NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1
ARG NEXT_PUBLIC_RELEASE

ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL
ENV NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=$NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY
ENV NEXT_PUBLIC_SENTRY_DSN=$NEXT_PUBLIC_SENTRY_DSN
ENV NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=$NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE
ENV NEXT_PUBLIC_RELEASE=$NEXT_PUBLIC_RELEASE

# Sources.
COPY packages/domain ./packages/domain
COPY apps/web ./apps/web

# Build packages/domain first — apps/web imports `@animbook/domain` and Next.js
# resolves it to packages/domain/dist/index.{js,d.ts}.
RUN npm run build -w @animbook/domain

# Build with the public env in scope.
RUN cd apps/web && npx next build

# ---- 3. runtime ------------------------------------------------------------
FROM node:20-alpine AS runtime
WORKDIR /app

ENV NODE_ENV=production
ENV PORT=3000
ENV HOSTNAME=0.0.0.0

# Copy the standalone bundle (apps/web/.next/standalone contains a fully
# runnable Next.js server that resolves workspaces via node_modules).
COPY --from=build /app/apps/web/.next/standalone ./
COPY --from=build /app/apps/web/.next/static ./apps/web/.next/static
COPY --from=build /app/apps/web/public ./apps/web/public

# Standalone strips workspace deps — re-add the domain package + node_modules.
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/packages/domain ./packages/domain

RUN chown -R node:node /app
USER node

EXPOSE 3000

HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://localhost:3000/ || exit 1

# Next.js standalone emits apps/web/server.js at the root of the standalone dir.
CMD ["node", "apps/web/server.js"]
