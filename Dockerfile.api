# AnimBook API — production image (multi-stage, monorepo root context).
#
# Build:    docker build -f Dockerfile.api -t animbook-api:latest .
# Run:      docker run --rm -p 4000:4000 --env-file apps/api/.env.production animbook-api:latest
#
# Why monorepo-root: the API depends on @animbook/domain (from packages/),
# apps/api's package.json, and the root workspaces manifest. Building from
# apps/api/ as the context loses access to packages/domain — the build fails.
#
# Multi-stage:
#   1. deps    — `npm ci` for just the API + domain workspaces (skip web/mobile/tv)
#   2. build   — `prisma generate` + `tsc`
#   3. runtime — minimal node:20-alpine + the compiled bundle + domain

# ---- 1. deps ---------------------------------------------------------------
FROM node:20-alpine AS deps
WORKDIR /app

# Root manifests.
COPY package.json package-lock.json .npmrc ./

# Only the workspaces the API needs. Skipping apps/web, apps/mobile,
# apps/tv entirely — they each have heavy install steps (Vite postinstall
# scripts hold file locks) that conflict with multi-workspace installs.
COPY packages/domain/package.json ./packages/domain/
COPY apps/api/package.json ./apps/api/

# Install only the API + domain workspaces + root deps. `--ignore-scripts`
# avoids the vite/expo postinstall scripts that cause EBUSY on rmdir.
RUN npm ci --legacy-peer-deps --ignore-scripts --no-audit --no-fund \
      --include-workspace-root \
      --workspace=apps/api \
      --workspace=packages/domain

# ---- 2. build --------------------------------------------------------------
FROM deps AS build
WORKDIR /app

# Sources the API needs.
COPY packages/domain ./packages/domain
COPY apps/api ./apps/api

# Build packages/domain first — apps/api's `import "@animbook/domain"` resolves
# to `packages/domain/dist/index.{js,d.ts}` (per packages/domain/package.json).
# If dist/ doesn't exist when tsc runs in apps/api, the module is unresolvable.
RUN npm run build -w @animbook/domain

# Prisma client generation + TypeScript compile.
RUN cd apps/api && npx prisma generate && npx tsc -p tsconfig.json

# ---- 3. runtime ------------------------------------------------------------
FROM node:20-alpine AS runtime
WORKDIR /app
ENV NODE_ENV=production
ENV PORT=4000
ENV HOSTNAME=0.0.0.0

# Build artefacts (dist/src — the actual entry, not the root index).
COPY --from=build /app/apps/api/dist/src ./apps/api/dist/src
# Prisma schema + generated client.
COPY --from=build /app/apps/api/prisma ./apps/api/prisma
# node_modules (hoisted + workspaces).
COPY --from=build /app/node_modules ./node_modules
# Domain package (runtime).
COPY --from=build /app/packages/domain ./packages/domain

# Lock down perms + drop to non-root.
RUN chown -R node:node /app
USER node

EXPOSE 4000

# Liveness probe — `/api/health/ready` checks DB + Redis + integrations.
HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://localhost:4000/api/health/ready || exit 1

CMD ["node", "apps/api/dist/src/index.js"]
